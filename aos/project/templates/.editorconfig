# ktlint 코드 스타일 설정 — 저장소 루트에 .editorconfig 이름으로 복사
# (도입 절차는 같은 폴더의 lint-setup.md 참조. aos-common·ParkGolfAOS는 2026-07-03 도입 완료)
root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
indent_size = 4
insert_final_newline = true

ktlint_code_style = android_studio
# 컴포저블은 PascalCase 함수가 컨벤션이므로 함수 네이밍 검사에서 제외
ktlint_function_naming_ignore_when_annotated_with = Composable
# 도입 초기 소음 방지 — 정착 후 조이기
max_line_length = off

# 팀 컨벤션과 충돌하는 규칙 비활성 (2026-07-03 도입 시 결정)
ktlint_standard_property-naming = disabled          # 네이밍 변경은 공개 API 파괴 위험 (라이브러리 호환성 규칙 우선)
ktlint_standard_backing-property-naming = disabled  # 동일
ktlint_standard_filename = disabled                 # 파일명 변경 리스크
ktlint_standard_no-wildcard-imports = disabled      # Android Studio 기본 import 동작과 충돌
ktlint_standard_kdoc = disabled                     # KDoc 위치 스타일 강제 안 함
ktlint_standard_comment-wrapping = disabled         # 인자 옆 한줄 주석 습관 허용
ktlint_standard_value-argument-comment = disabled
ktlint_standard_value-parameter-comment = disabled
