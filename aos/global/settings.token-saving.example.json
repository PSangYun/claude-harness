{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_HARNESS_STYLE_PROMPT": "compact"
  },
  "model": "claude-fable-5",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/inject-model-rules.js\""
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true
}
