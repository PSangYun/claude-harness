{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/quality-check.js",
            "status_message": "프로젝트 규칙 검사 중...",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-gate.js",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
